{
  "name": "opencode-artifact-canvas",
  "version": "0.2.7",
  "description": "Artifact Canvas TUI plugin for OpenCode",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Desiment/opencode-artifact-canvas.git"
  },
  "homepage": "https://github.com/Desiment/opencode-artifact-canvas#readme",
  "bugs": "https://github.com/Desiment/opencode-artifact-canvas/issues",
  "scripts": {
    "build:plugin": "bun run scripts/build-plugin.ts",
    "build:release": "bun run scripts/build-release.ts",
    "test": "bun test --timeout 30000",
    "typecheck": "tsgo --noEmit",
    "verify:release": "bun run scripts/verify-release.ts",
    "verify": "bun run typecheck && bun test --timeout 30000 && bun run build:release && bun run verify:release"
  },
  "exports": {
    "./tui": "./tui.js"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.5.12",
    "@opentui/solid": ">=0.5.12",
    "solid-js": ">=1.9.0"
  },
  "dependencies": {
    "@opencode/plugin": "^2.0.19",
    "diff": "8.0.4",
    "opentui-markdown-render": "0.2.11"
  },
  "devDependencies": {
    "@opentui/core": "0.8.2",
    "@opentui/solid": "0.8.2",
    "@tsconfig/bun": "1.0.9",
    "@types/bun": "1.4.0",
    "@typescript/native-preview": "7.0.0-dev.20251207.1",
    "solid-js": "1.9.18"
  }
}
